# Supabase (Project Settings → API Keys). Use the new publishable/secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app — used in email links.
SITE_URL=http://localhost:3000

# IANA timezone the club meets in (event times are entered and shown in it).
NEXT_PUBLIC_CLUB_TIMEZONE=Europe/London

# Resend. Leave RESEND_API_KEY empty in dev to print emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Nook Book Club <club@your-domain.com>"

# Shared secret for /api/cron/tick (send as "Authorization: Bearer <secret>").
# Generate with: openssl rand -hex 32
CRON_SECRET=
